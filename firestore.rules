rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /collectors/{uid} {
      // свій профіль читаєш завжди, чужий — лише якщо людина показує його на дошці обміну
      allow read: if request.auth != null && (request.auth.uid == uid || resource.data.public == true);
      // писати можна лише у свій профіль і лише ці поля
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['items','budget','name','photo','tg','city','public','v','updatedAt'])
        && request.resource.data.items is map && request.resource.data.items.size() <= 49;
    }
  }
}
